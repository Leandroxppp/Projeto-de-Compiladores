# Teste 8 - Avaliacao de 160 atividades: sequencial x paralelo em 4 nucleos
# 40 alunos x 4 atividades = 160 atividades.

func avaliar_lote(inicio, fim) {
    int i = 0;
    number acumulador = 0;
    for (i = inicio; i < fim; i = i + 1) {
        # Simula trabalho de CPU de uma correcao sem usar sleep.
        acumulador = acumulador + cpu_work(i + 1);
    }
    return acumulador;
}

seq {
    print("Total de Atividades a Avaliar: 160 (40 alunos x 4 atividades)");
    print("");

    print("--- 1. Executando Modo Sequencial (Apenas 1 Nucleo / Professor) ---");
    number inicio_seq = now_seconds();
    number resultado_seq = avaliar_lote(0, 160);
    number fim_seq = now_seconds();
    number tempo_seq = fim_seq - inicio_seq;
    print("Tempo Sequencial Concluido em: ", tempo_seq, " segundos");
    print("");

    print("--- 2. Executando Modo Paralelo (4 Nucleos Dedicados: Professor + 3 Monitores) ---");
    number inicio_par = now_seconds();

    fork professor on core(1) { avaliar_lote(0, 40); }
    fork monitor1 on core(2) { avaliar_lote(40, 80); }
    fork monitor2 on core(3) { avaliar_lote(80, 120); }
    fork monitor3 on core(4) { avaliar_lote(120, 160); }
    join(professor, monitor1, monitor2, monitor3);

    number fim_par = now_seconds();
    number tempo_par = fim_par - inicio_par;
    print("Tempo Paralelo Concluido em: ", tempo_par, " segundos");
    print("");

    number speedup = tempo_seq / tempo_par;
    number reducao = ((tempo_seq - tempo_par) / tempo_seq) * 100;

    print("==========================================");
    print("         BENCHMARK DE DESEMPENHO");
    print("==========================================");
    print("Tempo Sequencial : ", tempo_seq, " s");
    print("Tempo Paralelo   : ", tempo_par, " s");
    print("Aceleracao       : ", speedup, "x mais rapido!");
    print("Reducao no tempo : ", reducao, "% de economia");
    print("Nucleos utilizados no paralelo: 4");
    print("==========================================");
}
