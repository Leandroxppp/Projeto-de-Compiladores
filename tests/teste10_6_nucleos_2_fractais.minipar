# Teste 10 - 160 avaliacoes + Mandelbrot + Sierpinski: sequencial x paralelo em 6 nucleos.
# Nucleos 1 a 4: avaliadores. Nucleo 5: Mandelbrot ASCII. Nucleo 6: Tapete de Sierpinski.

func avaliar_lote(inicio, fim) {
    int i = 0;
    number acumulador = 0;
    for (i = inicio; i < fim; i = i + 1) {
        acumulador = acumulador + cpu_work(i + 1);
    }
    return acumulador;
}

seq {
    print("Carga de Trabalho: 160 atividades + Mandelbrot (ASCII) + Sierpinski (Turtle/visualizacao)");
    print("");

    # 1. Modo sequencial: um unico fluxo executa todas as cargas.
    print("--- 1. Executando Modo Sequencial (Apenas 1 Nucleo) ---");
    number inicio_seq = now_seconds();
    number resultado_seq = avaliar_lote(0, 160);
    string mandelbrot_seq = mandelbrot_ascii();
    string sierpinski_seq = sierpinski_ascii();
    number fim_seq = now_seconds();
    number tempo_seq = fim_seq - inicio_seq;
    print("Tempo Sequencial Concluido em: ", tempo_seq, " segundos");
    print("");

    # 2. Modo paralelo: 4 avaliadores + Mandelbrot + Sierpinski.
    print("--- 2. Executando Modo Paralelo (6 Nucleos Dedicados) ---");
    number inicio_par = now_seconds();

    fork avaliador1 on core(1) { avaliar_lote(0, 40); }
    fork avaliador2 on core(2) { avaliar_lote(40, 80); }
    fork avaliador3 on core(3) { avaliar_lote(80, 120); }
    fork avaliador4 on core(4) { avaliar_lote(120, 160); }
    fork fractal_mandelbrot on core(5) { mandelbrot_ascii(); }
    fork fractal_sierpinski on core(6) { sierpinski_ascii(); }
    join(avaliador1, avaliador2, avaliador3, avaliador4, fractal_mandelbrot, fractal_sierpinski);

    number fim_par = now_seconds();
    number tempo_par = fim_par - inicio_par;
    print("Tempo Paralelo Concluido em: ", tempo_par, " segundos");
    print("");

    # Visualizacoes apos o benchmark (sem compartilhar estado entre threads).
    string sierpinski_visual = sierpinski_ascii();
    string mandelbrot_visual = mandelbrot_ascii();
    print(sierpinski_visual);
    print("");
    print(mandelbrot_visual);
    print("");

    number speedup = tempo_seq / tempo_par;
    number reducao = ((tempo_seq - tempo_par) / tempo_seq) * 100;

    print("==========================================");
    print("         BENCHMARK DE DESEMPENHO");
    print("==========================================");
    print("Nucleos Utilizados (Paralelo) : 6");
    print("Tempo Sequencial               : ", tempo_seq, " s");
    print("Tempo Paralelo                 : ", tempo_par, " s");
    print("Aceleracao (Speedup)           : ", speedup, "x");
    print("Reducao de Tempo               : ", reducao, "%");
    print("==========================================");
}
