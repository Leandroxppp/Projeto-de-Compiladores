func fatorial(n) {
    int i = 1; int r = 1;
    for (i = 1; i <= n; i = i + 1) { r = r * i; }
    print("Fatorial = ", r); return r;
}
func fibonacci(n) {
    int a = 0; int b = 1; int i = 0; int t = 0;
    for (i = 0; i < n; i = i + 1) { t = a + b; a = b; b = t; }
    print("Fibonacci = ", a); return a;
}
par {
    fatorial(8);
    fibonacci(12);
}
